# Generated by zsh into $ZDOTDIR, which stow symlinks into this repo
.zcompdump*
zcompdump*
.zsh_history
.zsh_sessions/

# Machine-local git identity, created by install.sh. It lives in $HOME, but stow
# tree-folding could otherwise land it inside this repo.
git/.config/git/config.local

# nvim writes personal dictionary entries (`zg`) beside its config, which stow
# symlinks into this repo.
nvim/.config/nvim/spell/

# k9s rewrites these on every run, so they are deliberately left unmanaged. Belt and braces
# in case ~/.config/k9s ever gets tree-folded into the repo before install.sh creates it.
k9s/.config/k9s/config.yaml
k9s/.config/k9s/aliases.yaml

# ~/.claude is mostly runtime state that install.sh deliberately leaves unmanaged
# (projects/, sessions/, history.jsonl, plugins/, caches). Ignore the package wholesale and
# re-include only what is tracked, in case ~/.claude ever gets tree-folded into the repo.
claude/.claude/*
!claude/.claude/CLAUDE.md
!claude/.claude/settings.json

# Machine-local Claude Code overrides, same idea as git/config.local: not shareable.
claude/.claude/settings.local.json
