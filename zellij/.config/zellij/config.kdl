// Zellij. Only non-default settings live here — run `zellij setup --dump-config` to see
// every option with its default, and `zellij setup --dump-layout default` for the stock
// layout this one replaces.
//
// Keybindings are deliberately left at their defaults: the stock Ctrl-prefixed modes
// (Ctrl p/t/n/h/o/s/b/g/q) and the Alt shortcuts are all still active. The status-bar
// pane in layouts/main.kdl lists the ones available in the current mode.

// Vendored in themes/gruvbox.kdl rather than the built-in "gruvbox-dark", so the palette
// is pinned by this repo and matches starship's.
theme "gruvbox"

// layouts/main.kdl: 2/3 + 1/3 vertical split under the tab bar and status bar.
default_layout "main"

// No borders or per-pane titles. The split is still visible; the focused pane is still
// distinguishable. Toggle back per-session with Ctrl-p z.
pane_frames false

// Both of these silently rearrange panes out from under the 2/3-1/3 split: auto_layout
// swaps in a different arrangement as the pane count changes, and stacked_resize turns
// panes into a stack once they resize past a threshold.
auto_layout false
stacked_resize false

show_startup_tips false
show_release_notes false

// The status bar conveys the mode, so the session name in the tab bar is noise on top
// of it. Still load-bearing after the compact-bar to tab-bar swap: tab-bar renders a
// session name in the same position.
ui {
    pane_frames {
        hide_session_name true
    }
}
